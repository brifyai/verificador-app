# =============================================================================
# ONDAVERIFICADA - CONFIGURACIÓN DE ENTORNO (EJEMPLO)
# =============================================================================
# Copia este archivo como .env y configura tus valores reales
# cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# CONFIGURACIÓN DE BASE DE DATOS
# -----------------------------------------------------------------------------
# PostgreSQL Database URL
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_bd
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/ondaverificada_dev"

# -----------------------------------------------------------------------------
# AUTENTICACIÓN Y SEGURIDAD
# -----------------------------------------------------------------------------
# NextAuth.js Secret - Generar con: openssl rand -base64 32
NEXTAUTH_SECRET="tu_nextauth_secret_aqui_cambiar_por_uno_seguro"

# NextAuth URL (para producción)
NEXTAUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# APIS DE TRANSCRIPCIÓN E IA
# -----------------------------------------------------------------------------
# Abacus AI
ABACUSAI_API_KEY="tu_abacus_api_key_aqui"

# OpenAI
OPENAI_API_KEY="tu_openai_api_key_aqui"

# Groq
GROQ_API_KEY="tu_groq_api_key_aqui"

# AssemblyAI
ASSEMBLYAI_API_KEY="tu_assemblyai_api_key_aqui"

# -----------------------------------------------------------------------------
# GOOGLE DRIVE INTEGRATION
# -----------------------------------------------------------------------------
# Google Drive API Credentials
GOOGLE_CLIENT_ID="tu_google_client_id_aqui"
GOOGLE_CLIENT_SECRET="tu_google_client_secret_aqui"
GOOGLE_REFRESH_TOKEN="tu_google_refresh_token_aqui"

# Google Drive Folder ID para almacenar audios
GOOGLE_DRIVE_FOLDER_ID="tu_folder_id_aqui"

# -----------------------------------------------------------------------------
# CONFIGURACIÓN DE REDIS (OPCIONAL)
# -----------------------------------------------------------------------------
# Redis URL para cache y jobs queue
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# CONFIGURACIÓN DE MONITOREO
# -----------------------------------------------------------------------------
# Intervalo de captura por defecto (segundos)
DEFAULT_CAPTURE_INTERVAL=30

# Duración de captura por defecto (segundos)
DEFAULT_CAPTURE_DURATION=10

# Máximo de radios simultáneas
MAX_CONCURRENT_RADIOS=50

# -----------------------------------------------------------------------------
# CONFIGURACIÓN DE COSTOS
# -----------------------------------------------------------------------------
# Precio por detección por defecto (CLP)
DEFAULT_PRICE_PER_DETECTION=1000

# -----------------------------------------------------------------------------
# CONFIGURACIÓN DE DESARROLLO
# -----------------------------------------------------------------------------
# Modo de desarrollo
NODE_ENV="development"

# Habilitar logs de debug
DEBUG_MODE=true

# Habilitar datos mock (true para desarrollo, false para producción)
USE_MOCK_DATA=true